# paste — PasteHub sync relay. Grey-cloud direct path, same as pan:
# 443 stream SNI map (paste.hawkingrad.com -> 127.0.0.1:5251) -> this TLS backend -> 127.0.0.1:9021.
# No Authelia: clients authenticate with a bearer token derived from their sync key.
server {
    listen 80;
    server_name paste.hawkingrad.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 127.0.0.1:5251 ssl http2;
    server_name paste.hawkingrad.com;

    ssl_certificate     /etc/letsencrypt/live/paste.hawkingrad.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/paste.hawkingrad.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 5 MiB blobs plus encryption overhead; op batches stay well below this.
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:9021;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
